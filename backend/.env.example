# LedgerOps backend configuration.
# Copy this file to ".env" (which Git ignores) and edit it.
# NEVER commit .env and NEVER put real secrets in this example file.

# Required. One of: local, test, staging, production
APP_ENV=local

# Required. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The placeholder below is accepted ONLY when APP_ENV is local or test.
# In staging/production the app refuses to start with a placeholder or a short key.
SECRET_KEY=change-me-generate-a-real-secret-with-secrets-token-hex-32

# DEBUG, INFO, WARNING, ERROR or CRITICAL (default INFO)
LOG_LEVEL=INFO

# Must be true in staging/production. May be false for plain-http local development.
COOKIE_SECURE=false

# Must be false in staging/production.
DEBUG=false

# Serve the API docs at /api/v1/docs (default true)
ENABLE_DOCS=true

# PostgreSQL runtime URL. Missing configuration keeps readiness at 503.
DATABASE_URL=postgresql+psycopg://ledgerops_runtime:replace-local-password@localhost:5432/ledgerops
